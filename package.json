{
  "name": "signalk-m510e-connector",
  "version": "0.1.3",
  "description": "Records incoming VHF transmissions from an Icom IC-M510E/CT-M500 over WiFi as a searchable SignalK log",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "public/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-force-exit"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-instruments"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "M510E Connector"
  },
  "author": "Tobias Rosenstock (humppafreak)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BoatHacks/signalk-m510e-connector.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "ip": "^1.1.9",
    "is-rtp": "^2.0.0",
    "@penggy/easy-rtp-parser": "^1.0.2"
  }
}
